---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import OceanBackground from '../components/OceanBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Folio', description = 'Portfolio' } = Astro.props;
const base = import.meta.env.BASE_URL; // includes trailing slash, respects `base`

// Absolute URLs for social-card meta (crawlers don't resolve relative paths).
// Astro.site is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicons — .ico first (Chrome favors it), then SVG + PNG fallbacks.
        PNG/ICO are rasterized so the lettering doesn't depend on font support. */}
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    {/* Open Graph (Slack, LinkedIn, Discord, iMessage, WhatsApp, Facebook…) */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <OceanBackground />

    <!-- Deckle-edge filter for the paper sheets (used by .paper::before in CSS).
         feTurbulence + feDisplacementMap wobble the sheet's edges organically. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="paper-deckle" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014" numOctaves="2" seed="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="site-header">
      <a class="brand" href={base}>e k x.</a>
      <nav>
        <a href={base}>Home</a>
        <a href={`${base}blog/`}>Blog</a>
        <a href={`${base}cv/`}>CV</a>
        <a href={`${base}about/`}>About</a>
        <!-- ocean.js flips light/dark on click; CSS shows the matching icon. -->
        <button id="theme-toggle" type="button" aria-label="Toggle appearance">
          <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main class="site">
      <slot />
    </main>
  </body>
</html>
