---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---
<Base title={`${project.data.title} — Your Name`} description={project.data.description}>
  <article class="prose">
    <h1>{project.data.title}</h1>
    <p class="meta">
      {project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {project.data.url && (<> · <a href={project.data.url}>visit ↗</a></>)}
    </p>
    <Content />
    <a class="back" href={base}>&larr; Back home</a>
  </article>
</Base>
