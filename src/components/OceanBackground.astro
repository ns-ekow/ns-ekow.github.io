---
// Full-viewport WebGL "ocean" background.
//
// The renderer lives in /public/ocean.js (adapted from Earendil's Apache-2.0
// site — see README). It is loaded with is:inline so Astro serves it verbatim
// instead of bundling it. It looks for #canvas and, optionally, #theme-toggle
// and #logo.
const base = import.meta.env.BASE_URL;
---
<!-- transition:persist keeps the live WebGL context (and the star layer) alive
     across client-side navigations, so the lake renders continuously. -->
<canvas id="canvas" aria-hidden="true" transition:persist="ocean-canvas"></canvas>
<div class="skip-layer" aria-hidden="true" transition:persist="skip-layer"></div>
<!-- defer: this component renders at the top of <body>, so the script must wait
     for the full page (e.g. the header theme toggle) to be parsed before it runs.
     persist so it isn't re-added/re-run on navigation (the IIFE also self-guards). -->
<script src={`${base}ocean.js`} is:inline defer transition:persist="ocean-script"></script>
